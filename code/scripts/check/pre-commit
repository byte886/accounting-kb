#!/bin/bash
# Git pre-commit hook：提交前自动检查
# 检查内容：大文件、敏感信息、文件类型、【运行产物误入硬拦截】、新文档登记/类型标注、相对链接有效性、文档类型词白名单、命名一致性提示(警告级)、【OKF工程记忆bundle硬错误拦截】
# 运行产物模式表 ARTIFACT_RE 与 .gitignore 互为备份、两处同步（新增一类运行产物时一起改）
# 安装：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# 配置
MAX_FILE_SIZE=1048576  # 1MB（超过则警告，超过10MB则阻止）
HARD_LIMIT=10485760    # 10MB（硬限制，超过则阻止提交）

# 敏感信息关键词
SENSITIVE_PATTERNS=("password" "passwd" "secret" "api_key" "apikey" "access_token" "private_key" "token=")

echo "🔍 pre-commit 检查中..."

# 1. 检查大文件
echo ""
echo "📦 检查大文件..."
large_files=0
blocked=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt "$HARD_LIMIT" ]; then
      echo "  ❌ 超过10MB硬限制: $(du -h "$file" | cut -f1) $file"
      blocked=1
    elif [ "$size" -gt "$MAX_FILE_SIZE" ]; then
      echo "  ⚠️  超过1MB: $(du -h "$file" | cut -f1) $file"
      large_files=1
    fi
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo ""
  echo "❌ 提交被阻止：存在超过10MB的文件"
  echo "   请将大文件加入.gitignore，或移到项目目录外"
  exit 1
fi

# 2. 检查敏感信息
echo ""
echo "🔐 检查敏感信息..."
sensitive_found=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  # scripts/pre-commit 自身含敏感词检测列表，属自指，跳过；.enc 加密文件与 .md 不扫
  if [ -f "$file" ] && [[ "$file" != *.enc ]] && [[ "$file" != *.md ]] && [[ "$file" != scripts/pre-commit ]]; then
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
      if grep -qi "$pattern" "$file" 2>/dev/null; then
        echo "  ⚠️  可能包含敏感信息 ($pattern): $file"
        sensitive_found=1
      fi
    done
  fi
done

# 3. 检查.gitignore是否遗漏常见大文件类型
echo ""
echo "📋 检查文件类型..."
video_files=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$file" in
    *.mp4|*.mov|*.mkv|*.avi|*.wav|*.mp3|*.aac|*.flac)
      echo "  ⚠️  音视频文件: $file"
      video_files=1
      ;;
    *.pdf|*.doc|*.docx|*.ppt|*.pptx|*.xls|*.xlsx)
      echo "  ⚠️  文档文件: $file"
      video_files=1
      ;;
  esac
done

# 4. 运行产物误入拦截（硬阻止）。ARTIFACT_RE 与 .gitignore 互为备份、两处同步：
#    即使 .gitignore 漏配，这里仍按"运行产物长什么样"兜底；新增运行产物类别时两处一起改。
echo ""
echo "🧹 检查运行产物是否误入暂存区（硬阻止）..."
# 虚拟环境/依赖目录、运行日志与完成哨兵、data 数据抓包、.tmp 临时中转、转写结果、缓存/字节码
ARTIFACT_RE='(^|/)(venv|env|node_modules|__pycache__|\.tmp[^/]*|logs)(/|$)|(^|/)data/|(^|/)\.[A-Za-z0-9_]*done$|\.done$|\.pyc$|\.DS_Store$|(^|/)(transcripts_full|transcripts)(/|$)'
ARTIFACT_WHITELIST='^transcription/requirements\.txt$'
artifact_block=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  if echo "$file" | grep -qE "$ARTIFACT_WHITELIST"; then continue; fi
  # 4a 命中运行产物路径/命名特征
  if echo "$file" | grep -qE "$ARTIFACT_RE"; then
    echo "  ❌ 运行产物/环境文件不应入库: $file"
    artifact_block=1
  fi
  # 4b 已被 .gitignore 忽略却被 git add -f 强塞进暂存区
  if git check-ignore -q "$file" 2>/dev/null; then
    echo "  ❌ 该文件已被 .gitignore 忽略，勿强制添加: $file"
    artifact_block=1
  fi
done
if [ "$artifact_block" -eq 1 ]; then
  echo "   这些属于本地运行产物/环境/数据，应保留在本地由 .gitignore 忽略，不进仓库。"
  echo "   若确属误判，同步更新 ARTIFACT_RE 与 .gitignore 后重试；紧急可 git commit --no-verify（不推荐）。"
  exit 1
fi

# 5. 检查文档关联性（新增的.md文件是否在DOCUMENTATION_MAP.md中有记录，是否有类型标注）
echo ""
echo "📚 检查文档关联性..."
doc_issues=0
for file in $(git diff --cached --name-only --diff-filter=A); do
  # OKF 工程记忆 bundle 用 frontmatter type 而非中文 Context Block，其一致性由第 8 段 okf_validate 专管，此处豁免
  if [[ "$file" == *.md ]] && [[ "$file" != CHANGELOG.md ]] && [[ "$file" != project-management/* ]] && [[ "$file" != docs/project-management/memory/* ]]; then
    # 检查是否在DOCUMENTATION_MAP.md中有记录
    if ! grep -q "$file" docs/DOCUMENTATION_MAP.md 2>/dev/null; then
      echo "  ⚠️  新文档未在DOCUMENTATION_MAP.md中记录: $file"
      doc_issues=1
    fi
    # 检查是否有类型标注
    if ! head -10 "$file" | grep -q "文档类型\|更新频率\|维护者"; then
      echo "  ⚠️  新文档缺少类型标注（文档类型/更新频率/维护者）: $file"
      doc_issues=1
    fi
  fi
done

# 6. 检查相对链接有效性 + 文档类型词白名单（针对本次暂存的 .md：新增与修改）
echo ""
echo "🔗 检查相对链接与类型词..."
if ! python3 - <<'PYEOF'
import subprocess, os, re, sys
files = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=AM"],
                       capture_output=True, text=True).stdout.split()
link_re = re.compile(r'\[[^\]]*\]\(([^)]+)\)')
type_re = re.compile(r'文档类型\**[：:]\s*([A-Za-z]+)')
# 权威类型词表（与 DOCUMENTATION_GUIDE 3.1 保持一致，修改需同步）
ALLOWED = {"Task", "Concept", "Reference", "Governance", "Active", "Knowledge", "Template"}
bad_link, bad_type = [], []
for f in files:
    if not f.endswith(".md") or not os.path.isfile(f):
        continue
    base = os.path.dirname(f)
    in_fence = False
    head = ""
    with open(f, encoding="utf-8") as fh:
        for i, line in enumerate(fh, 1):
            if i <= 12:
                head += line
            if line.lstrip().startswith("```"):
                in_fence = not in_fence
                continue
            if in_fence:  # 跳过围栏代码块
                continue
            line = re.sub(r'`[^`]*`', '', line)  # 跳过行内代码
            for m in link_re.finditer(line):
                t = m.group(1).split('#')[0].strip()  # 去掉锚点
                if not t or t.startswith(("http", "mailto:", "<")):
                    continue  # 外链/邮件/占位不校验
                t = t.split()[0]
                if not os.path.exists(os.path.normpath(os.path.join(base, t))):
                    bad_link.append(f"{f}:{i} -> {t}")
    mt = type_re.search(head)
    # 仅当"标了类型但词不在白名单"时报错；按规范豁免、无头部标注的原始素材/知识库正文不查
    if mt and mt.group(1) not in ALLOWED:
        bad_type.append(f"{f}: 类型词 '{mt.group(1)}' 不在权威词表 {sorted(ALLOWED)}")
if bad_link:
    print("  ❌ 相对链接目标不存在（断链）:")
    for x in bad_link:
        print("     -", x)
if bad_type:
    print("  ❌ 文档类型词不在权威词表:")
    for x in bad_type:
        print("     -", x)
sys.exit(1 if (bad_link or bad_type) else 0)
PYEOF
then
  echo "   提交被阻止：请修复上述断链/类型词；确认无需处理时可用 git commit --no-verify 跳过"
  exit 1
fi

# 7. 命名一致性提示（警告级，不阻断；硬不自洽/影响面/回归请手动跑 check_naming_consistency.py）
echo ""
echo "🧭 检查命名一致性（仅提示，不阻止提交）..."
if [ -f scripts/check_naming_consistency.py ]; then
  python3 scripts/check_naming_consistency.py 2>/dev/null | sed 's/^/  /' || true
fi

# 8. OKF 工程记忆 bundle 一致性（E 硬错误阻断；仅当暂存触及 memory/ 或校验器本身时运行，未触及则零输出，避免无关提交空喊检查）
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^docs/project-management/memory/|^scripts/okf_validate\.py$'; then
  echo ""
  echo "🧠 检查 OKF 工程记忆 bundle..."
  if [ -f scripts/okf_validate.py ] && [ -d docs/project-management/memory ]; then
    okf_out=$(python3 scripts/okf_validate.py docs/project-management/memory 2>&1) && {
      echo "$okf_out" | tail -1 | sed 's/^/  /'
    } || {
      echo "$okf_out" | sed 's/^/  /'
      echo "   提交被阻止：OKF 记忆 bundle 存在硬错误(E)，修复后再提交；警告(W)/信息(I)见上，W 需逐条确认。"
      exit 1
    }
  fi
fi

# 总结
echo ""
if [ "$large_files" -eq 1 ] || [ "$sensitive_found" -eq 1 ] || [ "$video_files" -eq 1 ] || [ "$doc_issues" -eq 1 ]; then
  echo "⚠️  发现潜在问题，请确认是否继续提交"
  echo "   如需跳过检查: git commit --no-verify"
  # 不阻止提交，只警告（单人项目）
fi

echo "✅ pre-commit 检查完成"
exit 0
